{
  "binary": "docker",
  "backend": "docker",
  "container": "hexstrike-linux",
  "container_binary": "steghide",
  "category": "forensics",
  "description": "Steganography tool for hiding/extracting data (Linux sidecar)",
  "timeout": 60,
  "command": [
    "steghide",
    {
      "param": "action",
      "default": "extract"
    },
    "-sf",
    {
      "param": "cover_file",
      "alt_param": "file",
      "quote": true
    },
    {
      "param": "output_file",
      "template": "-xf '{value}'"
    },
    {
      "param": "passphrase",
      "template": "-p '{value}'"
    },
    {
      "param": "additional_args"
    }
  ],
  "name": "steghide"
}