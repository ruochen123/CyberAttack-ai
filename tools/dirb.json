    {
      "param": "url",
      "alt_param": "target"
    },
    {
      "param": "wordlist",
      "default": "/usr/share/wordlists/dirb/common.txt"
    },
    {
      "param": "additional_args"
    }
  ],
  "name": "dirb"
}