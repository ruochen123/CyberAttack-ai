{
  "binary": "docker",
  "backend": "docker",
  "container": "hexstrike-linux",
  "container_binary": "responder",
  "category": "network",
  "description": "LLMNR, NBT-NS and MDNS poisoner (Linux sidecar)",
  "timeout": 300,
  "command": [
    "responder",
    "-I",
    {
      "param": "interface",
      "default": "eth0"
    },
    {
      "param": "analyze",
      "flag": "-A"
    },
    {
      "param": "wpad",
      "flag": "-w",
      "default": true
    },
    {
      "param": "force_wpad_auth",
      "flag": "-F"
    },
    {
      "param": "fingerprint",
      "flag": "-f"
    },
    {
      "param": "additional_args",
      "default": "-vP"
    }
  ],
  "name": "responder"
}